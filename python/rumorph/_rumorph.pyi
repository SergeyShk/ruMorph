from collections.abc import Iterable
from os import PathLike
from pathlib import Path
from typing import Literal, final

class FormNotFoundError(LookupError): ...

@final
class Analysis:
    @property
    def word(self) -> str: ...
    @property
    def lemma(self) -> str: ...
    @property
    def pos(self) -> str: ...
    @property
    def feats(self) -> dict[str, str]: ...
    @property
    def labels(self) -> frozenset[str]: ...
    @property
    def prob(self) -> float: ...
    @property
    def source(self) -> Literal["dictionary"]: ...
    def forms(self) -> list[Analysis]: ...
    def inflect(self, **feats: str) -> str: ...
    def agree(self, number: int) -> str: ...

@final
class Analyzer:
    def __init__(self, path: str | PathLike[str] | None = None) -> None: ...
    @property
    def path(self) -> Path: ...
    def analyze(self, word: str) -> list[Analysis]: ...
    def analyze_many(self, words: Iterable[str]) -> list[list[Analysis]]: ...
    def lemmatize(self, words: Iterable[str]) -> list[str]: ...
    def is_known(self, word: str) -> bool: ...
